  m_text: "\uCE74\uB4DC\uB294 10\uC885\uB958\uAD6C\uC694! \uCD1D 20\uC7A5\uC774\uC5D0\uC694!\n\n\uCC98\uC74C\uC5D0
    \uCE74\uB4DC\uB97C \uBCF4\uC5EC\uC904\uD14C\uB2C8\uAE4C \uC798 \uAE30\uC5B5\uD574\uC57C
