  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC120\uC0DD\uB2D8! \uC81C\uAC00 '\uBB34\uAD81\uD654 \uAF43\uC774 \uD53C\uC5C8\uC2B5\uB2C8\uB2E4'\uB97C
    \uB9D0\uD560 \uAC70\uC608\uC694!\n\uAC8C\uC784\uC740 30\uCD08 \uB3D9\uC548 \uC9C4\uD589\uD574\uC694!\n\uB9D0\uD558\uB294
    \uB3D9\uC548\uC5D0\uB294 \uD654\uBA74\uC744 \uD130\uCE58\uB97C \uB9C8\uAD6C\uB9C8\uAD6C
    \uD574\uC11C \uC6C0\uC9C1\uC5EC\uC694!\n <\uBB34\uAD81\uD654 \uAF43\uC774 \uD53C\uC5C8\uC2B5\uB2C8\uB2E4>\uB97C
    \uB2E4 \uB9D0\uD588\uC744 \uB54C \uD654\uBA74\uC744 \uB204\uB974\uBA74 \uC120\uC0DD\uB2D8\uC774
    \uC9C4 \uAC70\uC608\uC694!\n15\uCD08\uB3D9\uC548 \uB3C4\uCC29\uC744 \uBABB\uD574\uB3C4
    \uC120\uC0DD\uB2D8\uC774 \uC9C4 \uAC70\uC608\uC694\n\uD55C \uBC88\uB3C4 \uC548
    \uAC78\uB9AC\uACE0 \uB05D\uAE4C\uC9C0 \uB3C4\uCC29\uD558\uBA74 \uC120\uC0DD\uB2D8\uC774
    \uC774\uAE30\uB294 \uAC70\uC608\uC694!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0a974096e9421cd4a9bbb16ec0f38b7c, type: 2}
